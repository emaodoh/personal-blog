# Application environment
APP_ENV=production
APP_DEBUG=false

# Admin account. These values create or update the account on startup.
ADMIN_USERNAME=emodoh
ADMIN_PASSWORD=Emmanuel419841241

# Session settings
SESSION_COOKIE_SECURE=true
SESSION_MAX_AGE_SECONDS=43200
PBKDF2_ITERATIONS=600000
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=900

# Persistent SQLite database and backups
DATABASE_PATH=/var/lib/myblog/data.db
BACKUP_DIR=/var/backups/myblog
BACKUP_RETENTION=14
